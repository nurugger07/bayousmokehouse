PORT=3000
DATABASE_URL=postgres://localhost:5432/bayousmokehouse_dev
SESSION_SECRET=replace-with-a-long-random-string
# Generate with: node -e "require('bcrypt').hash('your-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Gmail SMTP for contact-form notification emails. GMAIL_APP_PASSWORD
# requires 2-Step Verification + an App Password from
# myaccount.google.com/apppasswords — not your regular Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional — defaults to GMAIL_USER if unset.
ADMIN_NOTIFICATION_EMAIL=
