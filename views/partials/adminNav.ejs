<header class="site-header">
  <div class="container site-header__inner">
    <span class="site-logo">Bayou Smokehouse Admin</span>
    <% if (loggedIn) { %>
      <nav class="site-nav">
        <a href="/">View Site</a>
        <a href="/admin/messages">Messages</a>
        <div class="dropdown">
          <button type="button" class="dropdown__toggle" aria-expanded="false" aria-controls="reports-dropdown-menu">Reports</button>
          <div class="dropdown__menu" id="reports-dropdown-menu">
            <a href="/admin/sales/totals">Sales Totals</a>
            <a href="/admin/sales/items">Item Sales</a>
            <a href="/admin/sales/tax">Tax Totals</a>
            <a href="/admin/sales/tips">Tip Totals</a>
            <a href="/admin/sales/weekly">Weekly Totals</a>
            <a href="/admin/sales/unmatched">Unmatched Days</a>
          </div>
        </div>
        <a href="/admin/sales/locations">Manage Locations</a>
        <a href="/admin/tax/jurisdictions">Tax Jurisdictions</a>
      </nav>
      <div class="site-header__actions">
        <form method="POST" action="/admin/logout" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--small btn--secondary">Log Out</button>
        </form>
      </div>
    <% } %>
  </div>
</header>
