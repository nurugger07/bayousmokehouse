<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Contact' }) %>
</head>
<body>
<%- include('../partials/nav') %>

<main>
  <section class="hero hero--photo">
    <div class="container">
      <h1>Contact Us</h1>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <% if (submitted) { %>
        <p class="form-message form-message--success">Thanks for reaching out! We'll get back to you soon.</p>
      <% } %>
      <% if (error) { %>
        <p class="form-message form-message--error"><%= error %></p>
      <% } %>

      <form class="contact-form" method="POST" action="/contact">
        <p class="form-required-note"><span class="required-mark" aria-hidden="true">*</span> Required field</p>

        <fieldset class="contact-form__categories">
          <legend>What can we help with? <span class="required-mark" aria-hidden="true">*</span></legend>

          <label class="contact-form__radio">
            <input type="radio" name="category" value="private_event" <%= values.category === 'private_event' ? 'checked' : '' %> required>
            Private Event
          </label>

          <label class="contact-form__radio">
            <input type="radio" name="category" value="brewery_event" <%= values.category === 'brewery_event' ? 'checked' : '' %> required>
            Brewery Event
          </label>

          <label class="contact-form__radio">
            <input type="radio" name="category" value="general_inquiry" <%= values.category === 'general_inquiry' ? 'checked' : '' %> required>
            Comments / Questions
          </label>
        </fieldset>

        <label for="name">Name <span class="required-mark" aria-hidden="true">*</span></label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" maxlength="255" required>

        <label for="email">Email <span class="required-mark" aria-hidden="true">*</span></label>
        <input type="email" id="email" name="email" value="<%= values.email || '' %>" maxlength="255" required>

        <label for="phone">Phone (optional)</label>
        <input type="tel" id="phone" name="phone" value="<%= values.phone || '' %>" maxlength="50">

        <label for="message">Message <span class="required-mark" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="6" required><%= values.message || '' %></textarea>

        <div class="visually-hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off">
        </div>

        <button type="submit" class="btn btn--primary">Send Message</button>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
