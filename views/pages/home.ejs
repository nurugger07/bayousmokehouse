<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Home' }) %>
</head>
<body>
<%- include('../partials/nav') %>

<main>
  <section class="hero hero--photo">
    <div class="container">
      <h1>Southern Treats &amp; Cajun Eats</h1>
      <p class="hero__subtitle">Bringing the food and culture of the South to Northern Colorado, one smoky, messy, delicious plate at a time.</p>
      <a href="/menu" class="btn btn--primary">See the Menu</a>
    </div>
  </section>

  <section id="schedule" class="schedule">
    <div class="container schedule__layout">
      <div class="schedule__intro">
        <h2>This Week's Schedule</h2>
        <p class="schedule__intro-text">We're out slinging Southern smoke all over Northern Colorado. Check the list for where to find us this week.</p>
        <p class="schedule__intro-text">Want us at your next event?</p>
        <a href="/contact" class="btn btn--primary">Book the Bayou</a>
      </div>

      <div class="schedule__listing">
        <p class="schedule__range"><%= schedule.weekStart %> &ndash; <%= schedule.weekEnd %></p>

        <% if (schedule.unavailable) { %>
          <p class="schedule__note">Schedule temporarily unavailable &mdash; check back soon.</p>
        <% } else if (schedule.days.length === 0) { %>
          <p class="schedule__note">Sold Out This Week. Come back later for next week's schedule.</p>
        <% } else { %>
          <div class="schedule__week">
            <% schedule.days.forEach(function(day) { %>
              <% day.events.forEach(function(event) { %>
                <% if (event.description || event.location) { %>
                  <details class="schedule-day">
                    <summary class="schedule-day__summary">
                      <div class="schedule-day__header">
                        <span class="schedule-day__name"><%= day.dayName %></span>
                        <span class="schedule-day__toggle" aria-hidden="true"></span>
                      </div>
                      <div class="schedule-day__details">
                        <span class="schedule-day__location"><%= event.name %></span>
                        <% if (event.shortLocation) { %>
                          <span class="schedule-day__location"><%= event.shortLocation %></span>
                        <% } %>
                        <% if (event.startTime) { %>
                          <span class="schedule-day__time"><%= event.startTime %> &ndash; <%= event.endTime %></span>
                        <% } %>
                      </div>
                    </summary>
                    <div class="schedule-day__panel">
                      <% if (event.location) { %>
                        <p class="schedule-day__address">
                          <a href="<%= event.mapsUrl %>" target="_blank" rel="noopener noreferrer"><%= event.location %></a>
                        </p>
                      <% } %>
                      <% if (event.description) { %>
                        <p class="schedule-day__description"><%= event.description %></p>
                      <% } %>
                    </div>
                  </details>
                <% } else { %>
                  <div class="schedule-day">
                    <div class="schedule-day__header">
                      <span class="schedule-day__name"><%= day.dayName %></span>
                    </div>
                    <div class="schedule-day__details">
                      <span class="schedule-day__location"><%= event.name %></span>
                      <% if (event.startTime) { %>
                        <span class="schedule-day__time"><%= event.startTime %> &ndash; <%= event.endTime %></span>
                      <% } %>
                    </div>
                  </div>
                <% } %>
              <% }); %>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="container">
      <h2>We're Southern.</h2>
      <img src="/images/food/jambalaya-plate.jpg" alt="A plate of Bayou Smokehouse jambalaya" class="content-image">
      <p>Bayou Smokehouse is a family-owned Northern Colorado food truck bringing the food, culture, and hospitality of the American South to Colorado. Low-Country seafood, smoked meats, Cajun-inspired comfort food &mdash; the kind of food where getting a little messy is part of the experience.</p>
      <a href="/about" class="btn btn--secondary">Our Story</a>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
