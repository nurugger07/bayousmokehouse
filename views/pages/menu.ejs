<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Menu' }) %>
</head>
<body>
<%- include('../partials/nav') %>

<main>
  <section class="page-header">
    <div class="container">
      <h1>Menu</h1>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <% menuSections.forEach(function(section) { %>
        <h2><%= section.title %></h2>
        <div class="menu-list">
          <% section.items.forEach(function(item) { %>
            <details class="menu-item">
              <summary class="menu-item__summary">
                <span class="menu-item__name"><%= item.name %></span>
                <span class="menu-item__toggle" aria-hidden="true"></span>
                <% if (item.price) { %>
                  <span class="menu-item__price"><%= item.price %></span>
                <% } %>
              </summary>
              <div class="menu-item__panel">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>" class="menu-item__image">
                <% } %>
                <p class="menu-item__description"><%= item.description %></p>
              </div>
            </details>
          <% }); %>
        </div>
      <% }); %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
