<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Tip Totals' }) %>
</head>
<body>
<%- include('../partials/adminNav', { loggedIn: true }) %>

<main>
  <section class="content">
    <div class="container">
      <h1>Tip Totals by Location</h1>

      <%- include('../partials/salesNav', { active: 'tips' }) %>

      <%- include('../partials/salesFilterForm', { action: '/admin/sales/tips', locations, filters }) %>

      <% if (rows.length === 0) { %>
        <p>No tips in this range.</p>
      <% } %>

      <% if (rows.length > 0) {
        var totalVisits = rows.reduce(function(sum, row) { return sum + Number(row.visit_count); }, 0);
        var totalOrders = rows.reduce(function(sum, row) { return sum + Number(row.order_count); }, 0);
        var totalCents = rows.reduce(function(sum, row) { return sum + Number(row.tip_money_cents); }, 0);
      %>
        <div class="table-scroll">
          <table class="admin-table" data-sortable>
            <thead>
              <tr>
                <th>Location</th>
                <th>City, State</th>
                <th data-sort-type="number">Day</th>
                <th data-sort-type="number">Visits</th>
                <th data-sort-type="number">Orders</th>
                <th data-sort-type="number">Tips</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(row) { %>
                <tr>
                  <td><%= row.location_name %></td>
                  <td><%= row.city_state || '—' %></td>
                  <td data-sort-value="<%= row.day_of_week %>"><%= row.dayOfWeekLabel %></td>
                  <td><%= row.visit_count %></td>
                  <td><%= row.order_count %></td>
                  <td data-sort-value="<%= row.tip_money_cents %>">$<%= (row.tip_money_cents / 100).toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3">Total</td>
                <td><%= totalVisits %></td>
                <td><%= totalOrders %></td>
                <td>$<%= (totalCents / 100).toFixed(2) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
