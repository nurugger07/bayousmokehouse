<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Manage Locations' }) %>
</head>
<body>
<%- include('../partials/adminNav', { loggedIn: true }) %>

<main>
  <section class="content">
    <div class="container">
      <h1>Manage Locations</h1>
      <p>
        City/State is parsed from the calendar event's address the first time each location is created, and never
        touched again automatically. So if an event's address was wrong or missing back then, fixing the calendar
        event now won't retroactively fix it here. Correct it below instead: paste the full address (it'll be
        re-parsed the same way the nightly sync does) or just type the city and state directly.
      </p>
      <p>
        Renaming only changes what's displayed. It doesn't stop a future sync from recreating the old name if that's
        still what's typed into the calendar event. If two locations are really the same venue (the calendar just
        named it differently at different times), use <strong>Merge</strong> instead: it moves all of one location's
        sales history onto another and removes the duplicate.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-message form-message--error"><%= error %></p>
      <% } %>

      <h2><%= editingLocation ? 'Edit Location' : 'Add Location' %></h2>

      <form
        class="contact-form"
        method="POST"
        action="<%= editingLocation ? '/admin/sales/locations/' + editingLocation.id : '/admin/sales/locations' %>"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="contact-form__row">
          <div>
            <label for="name">Name <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" value="<%= editingLocation ? editingLocation.name : '' %>" required>
          </div>
          <div>
            <label for="cityState">City, State (or paste a full address)</label>
            <input type="text" id="cityState" name="cityState" value="<%= editingLocation ? (editingLocation.city_state || '') : '' %>" placeholder="e.g. Loveland, CO">
          </div>
        </div>

        <% if (jurisdictions.length > 0) { %>
          <label>Tax Jurisdictions</label>
          <% jurisdictions.forEach(function(j) { %>
            <p style="margin: 0.25rem 0;">
              <label for="jurisdiction-<%= j.id %>" style="font-weight: normal;">
                <input
                  type="checkbox"
                  id="jurisdiction-<%= j.id %>"
                  name="jurisdictionIds"
                  value="<%= j.id %>"
                  <%= editingJurisdictionIds.includes(j.id) ? 'checked' : '' %>
                >
                <%= j.name %> (<%= j.level %>)
              </label>
            </p>
          <% }); %>
        <% } %>

        <button type="submit" class="btn btn--primary"><%= editingLocation ? 'Save Changes' : 'Add Location' %></button>
        <% if (editingLocation) { %>
          <a href="/admin/sales/locations" class="btn btn--secondary">Cancel</a>
        <% } %>
      </form>

      <h2>Locations</h2>

      <% if (locations.length === 0) { %>
        <p>No locations yet.</p>
      <% } %>

      <% if (locations.length > 0) { %>
        <div class="table-scroll">
          <table class="admin-table" data-sortable>
            <thead>
              <tr>
                <th>Name</th>
                <th>City, State</th>
                <th>Tax Jurisdictions</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% locations.forEach(function(location) { %>
                <% var assignedIds = jurisdictionIdsByLocation.get(location.id) || []; %>
                <% var assignedNames = jurisdictions.filter(function(j) { return assignedIds.includes(j.id); }).map(function(j) { return j.name; }); %>
                <% var otherLocations = locations.filter(function(other) { return other.id !== location.id; }); %>
                <tr>
                  <td><%= location.name %></td>
                  <td><%= location.city_state || 'Not set' %></td>
                  <td><%= assignedNames.length > 0 ? assignedNames.join(', ') : 'None' %></td>
                  <td>
                    <div class="admin-table__actions">
                      <a href="/admin/sales/locations?editId=<%= location.id %>" class="btn btn--small btn--secondary">Edit</a>

                      <form method="POST" action="/admin/sales/locations/<%= location.id %>/delete" style="display:inline" onsubmit="return confirm('Delete &quot;<%= location.name %>&quot;? This cannot be undone.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn--small btn--secondary">Delete</button>
                      </form>

                      <% if (otherLocations.length > 0) { %>
                        <form method="GET" action="/admin/sales/locations/<%= location.id %>/merge" style="display:inline">
                          <select name="targetId" required aria-label="Merge <%= location.name %> into&hellip;">
                            <option value="" disabled selected>Merge into&hellip;</option>
                            <% otherLocations.forEach(function(other) { %>
                              <option value="<%= other.id %>"><%= other.name %></option>
                            <% }); %>
                          </select>
                          <button type="submit" class="btn btn--small btn--secondary">Merge</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
