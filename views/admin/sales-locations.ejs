<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Manage Locations' }) %>
</head>
<body>
<%- include('../partials/adminNav', { loggedIn: true }) %>

<main>
  <section class="content">
    <div class="container">
      <h1>Manage Locations</h1>
      <p>
        City/State is parsed from the calendar event's address the first time each location is created, and never
        touched again automatically. So if an event's address was wrong or missing back then, fixing the calendar
        event now won't retroactively fix it here. Correct it below instead: paste the full address (it'll be
        re-parsed the same way the nightly sync does) or just type the city and state directly.
      </p>
      <p>
        Renaming only changes what's displayed. It doesn't stop a future sync from recreating the old name if that's
        still what's typed into the calendar event. If two locations are really the same venue (the calendar just
        named it differently at different times), use <strong>Merge</strong> instead: it moves all of one location's
        sales history onto another and removes the duplicate.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-message form-message--error"><%= error %></p>
      <% } %>

      <% if (locations.length === 0) { %>
        <p>No locations yet.</p>
      <% } %>

      <% if (locations.length > 0) { %>
        <div class="menu-list">
          <% locations.forEach(function(location) { %>
            <div class="menu-item">
              <div class="menu-item__summary" style="cursor: default;">
                <span class="menu-item__name"><%= location.name %></span>
                <span class="menu-item__price"><%= location.city_state || 'No city/state set' %></span>
              </div>
              <div class="menu-item__panel">
                <form method="POST" action="/admin/sales/locations/<%= location.id %>/rename" class="contact-form" style="margin-top: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="contact-form__row">
                    <div>
                      <label for="name-<%= location.id %>">Name</label>
                      <input type="text" id="name-<%= location.id %>" name="name" value="<%= location.name %>" required>
                    </div>
                  </div>
                  <button type="submit" class="btn btn--small btn--secondary">Rename</button>
                </form>

                <form method="POST" action="/admin/sales/locations/<%= location.id %>/city-state" class="contact-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="contact-form__row">
                    <div>
                      <label for="cityState-<%= location.id %>">City, State (or paste a full address)</label>
                      <input type="text" id="cityState-<%= location.id %>" name="cityState" value="<%= location.city_state || '' %>" placeholder="e.g. Loveland, CO">
                    </div>
                  </div>
                  <button type="submit" class="btn btn--small btn--primary">Save</button>
                </form>

                <% if (jurisdictions.length > 0) { %>
                  <% var assignedIds = jurisdictionIdsByLocation.get(location.id) || []; %>
                  <form method="POST" action="/admin/sales/locations/<%= location.id %>/tax-jurisdictions" class="contact-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>Tax Jurisdictions</label>
                    <% jurisdictions.forEach(function(j) { %>
                      <p style="margin: 0.25rem 0;">
                        <label for="jurisdiction-<%= location.id %>-<%= j.id %>" style="font-weight: normal;">
                          <input
                            type="checkbox"
                            id="jurisdiction-<%= location.id %>-<%= j.id %>"
                            name="jurisdictionIds"
                            value="<%= j.id %>"
                            <%= assignedIds.includes(j.id) ? 'checked' : '' %>
                          >
                          <%= j.name %> (<%= j.level %>)
                        </label>
                      </p>
                    <% }); %>
                    <button type="submit" class="btn btn--small btn--secondary">Save Jurisdictions</button>
                  </form>
                <% } %>

                <% var otherLocations = locations.filter(function(other) { return other.id !== location.id; }); %>
                <% if (otherLocations.length > 0) { %>
                  <form method="GET" action="/admin/sales/locations/<%= location.id %>/merge" class="contact-form">
                    <div class="contact-form__row">
                      <div>
                        <label for="targetId-<%= location.id %>">Merge this location into&hellip;</label>
                        <select id="targetId-<%= location.id %>" name="targetId" required>
                          <option value="" disabled selected>Choose a location</option>
                          <% otherLocations.forEach(function(other) { %>
                            <option value="<%= other.id %>"><%= other.name %></option>
                          <% }); %>
                        </select>
                      </div>
                    </div>
                    <button type="submit" class="btn btn--small btn--secondary">Review Merge&hellip;</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
