<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Messages' }) %>
</head>
<body>
<%- include('../partials/adminNav', { loggedIn: true }) %>

<main>
  <section class="content">
    <div class="container">
      <h1>Messages &mdash; <%= status.charAt(0).toUpperCase() + status.slice(1) %></h1>

      <% if (messages.length === 0) { %>
        <p>No messages here.</p>
      <% } %>

      <div class="menu-list">
        <% messages.forEach(function(message) { %>
          <div class="menu-item">
            <div class="menu-item__summary" style="cursor: default;">
              <span class="menu-item__name">
                <a href="/admin/messages/<%= message.id %>"><%= message.name %></a>
                &mdash; <%= message.email %>
              </span>
              <span class="menu-item__price"><%= new Date(message.submitted_at).toLocaleString() %></span>
            </div>
            <div class="menu-item__panel">
              <p class="menu-item__description"><%= message.message %></p>
            </div>
            <div class="admin-actions">
              <% if (status === 'deleted') { %>
                <form method="POST" action="/admin/messages/<%= message.id %>/restore">
                  <button type="submit" class="btn btn--small btn--secondary">Restore</button>
                </form>
              <% } else { %>
                <% if (message.status === 'unread') { %>
                  <form method="POST" action="/admin/messages/<%= message.id %>/read">
                    <button type="submit" class="btn btn--small btn--secondary">Mark Read</button>
                  </form>
                <% } %>
                <% if (status !== 'archived') { %>
                  <form method="POST" action="/admin/messages/<%= message.id %>/archive">
                    <button type="submit" class="btn btn--small btn--secondary">Archive</button>
                  </form>
                <% } %>
                <form method="POST" action="/admin/messages/<%= message.id %>/delete">
                  <button type="submit" class="btn btn--small btn--secondary">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
