<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Tax Totals' }) %>
</head>
<body>
<%- include('../partials/adminNav', { loggedIn: true }) %>

<main>
  <section class="content">
    <div class="container">
      <h1>Tax Totals by City, State</h1>
      <p>Grouped by tax jurisdiction (city/state) rather than individual venue, since sales tax is collected at that level.</p>

      <nav class="admin-filters">
        <a href="/admin/sales/totals">Sales Totals</a>
        <a href="/admin/sales/items">Item Sales</a>
        <a href="/admin/sales/tax" class="admin-filters__active">Tax Totals</a>
        <a href="/admin/sales/tips">Tip Totals</a>
        <a href="/admin/sales/unmatched">Unmatched Days</a>
      </nav>

      <%- include('../partials/salesFilterForm', { action: '/admin/sales/tax', locations, filters }) %>

      <% if (rows.length === 0) { %>
        <p>No sales in this range.</p>
      <% } %>

      <% if (rows.length > 0) {
        var totalVisits = rows.reduce(function(sum, row) { return sum + Number(row.visit_count); }, 0);
        var totalOrders = rows.reduce(function(sum, row) { return sum + Number(row.order_count); }, 0);
        var totalCents = rows.reduce(function(sum, row) { return sum + Number(row.tax_money_cents); }, 0);
      %>
        <div class="table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>City, State</th>
                <th>Visits</th>
                <th>Orders</th>
                <th>Tax Collected</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(row) { %>
                <tr>
                  <td><%= row.city_state %></td>
                  <td><%= row.visit_count %></td>
                  <td><%= row.order_count %></td>
                  <td>$<%= (row.tax_money_cents / 100).toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot>
              <tr>
                <td>Total</td>
                <td><%= totalVisits %></td>
                <td><%= totalOrders %></td>
                <td>$<%= (totalCents / 100).toFixed(2) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
